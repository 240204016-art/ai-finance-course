# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111,222222222

# Отправка кодов подтверждения на почту @sdu.edu.kz — нужен ОДИН из двух способов.
#
# Способ 1 (для Railway): Brevo HTTPS API. На Railway (тарифы Trial/Hobby) SMTP-порты закрыты.
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=ваш_подтверждённый_в_Brevo_адрес@gmail.com
# EMAIL_FROM_NAME=SDU Taxi Share
#
# Способ 2: SMTP (для запуска на своём компьютере/сервере)
# Порт 465 — SSL, любой другой (обычно 587) — STARTTLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sdu.taxi.share@gmail.com
SMTP_PASSWORD=app-password-here
# Необязательно: адрес отправителя (по умолчанию = SMTP_USER)
# SMTP_FROM=sdu.taxi.share@gmail.com

# true — письма не отправляются, код печатается в консоль (для тестов)
DEV_MODE=true

# Необязательно (на Railway путь к базе берётся с подключённого Volume автоматически):
# DB_PATH=data/bot.db
# CODE_SECRET=случайная-длинная-строка-для-хэширования-кодов
