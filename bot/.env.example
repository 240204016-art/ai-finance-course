# Осы файлды .env деп көшіріп, мәндерін толтырыңыз. .env файлы git-ке түспейді.

# @BotFather берген токен
BOT_TOKEN=

# Чектерді растайтын адамдардың Telegram ID-і (үтірмен). Өз ID-іңізді ботқа /id жазып білесіз.
ADMIN_IDS=

# Жабық арнаның ID-і (-100... түрінде). Ботты арнаға әкімші етіп қоссаңыз, ID-ді өзі жібереді.
CHANNEL_ID=

# Өнім атауы мен бағасы (₸). Баға landing/config.js ішіндегі price-пен бірдей болсын.
PRODUCT_NAME=Курс атауы
PRICE=9900

# Kaspi деректері: аударым нөмірі мен алушы аты және/немесе Kaspi Pay төлем сілтемесі
KASPI_PHONE=+7 700 000 00 00
KASPI_NAME=Аты Т.
KASPI_PAY_URL=

# Оферта беті мен қолдау аккаунты (міндетті емес)
OFERTA_URL=https://240204016-art.github.io/ai-finance-course/landing/oferta.html
SUPPORT=

# Промокодтар: КОД:баға, үтірмен. Мысалы: START:7900,DOS:8900
PROMOS=
